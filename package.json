{
  "name": "gestor-esdeveniments-personal",
  "productName": "GestorEsdevenimentsPersonal",
  "version": "1.6.4",
  "description": "Una aplicació per gestionar esdeveniments i personal",
  "author": "Pep",
  "license": "GPL-3.0-or-later",
  "main": "main.cjs",
  "type": "module",
  "packageManager": "pnpm@8.15.8",
  "scripts": {
    "dev": "vite --force --clearScreen false",
    "build:theme": "node scripts/build-theme.cjs",
    "wait": "node -e \"setTimeout(() => process.exit(0), 500)\"",
    "build": "pnpm run build:theme && tsc && vite build",
    "preview": "vite preview",
    "electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "electron-dev": "concurrently \"pnpm run dev\" \"pnpm run electron\"",
    "start": "pnpm run build:theme && pnpm run wait && pnpm run electron-dev",
    "clean": "rm -rf dist node_modules/.vite",
    "fresh-start": "pnpm run clean && pnpm start",
    "postversion": "node scripts/update-version.cjs",
    "build:electron": "pnpm run build && electron-builder",
    "dist": "electron-builder",
    "// COMMENT": "--- SCRIPTS DE COMPILACIÓ LOCAL (Amb valors per defecte) ---",
    "build:mac": "export BRANCH_NAME=${BRANCH_NAME:-local} && export BUILD_NUMBER=${BUILD_NUMBER:-dev} && pnpm run build && electron-builder --mac --x64 --publish never",
    "build:linux": "export BRANCH_NAME=${BRANCH_NAME:-local} && export BUILD_NUMBER=${BUILD_NUMBER:-dev} && pnpm run build && electron-builder --linux --x64 --publish never",
    "build:win": "export BRANCH_NAME=${BRANCH_NAME:-local} && export BUILD_NUMBER=${BUILD_NUMBER:-dev} && pnpm run build && electron-builder --win --x64 --publish never",
    "i18n:extract:desktop": "pnpm exec i18next-parser --config i18next-parser.config.cjs",
    "i18n:extract:mobile": "pnpm exec i18next-parser --config i18next-parser.mobile.config.cjs",
    "i18n:extract:web": "pnpm exec i18next-parser --config i18next-parser.web.config.cjs",
    "i18n:extract:all": "pnpm run i18n:extract:desktop && pnpm run i18n:extract:mobile && pnpm run i18n:extract:web"
  },
  "dependencies": {
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fullcalendar/core": "6.1.17",
    "@fullcalendar/daygrid": "6.1.17",
    "@fullcalendar/interaction": "6.1.17",
    "@fullcalendar/list": "6.1.17",
    "@fullcalendar/multimonth": "6.1.17",
    "@fullcalendar/react": "6.1.17",
    "@fullcalendar/timegrid": "6.1.17",
    "@heroicons/react": "2.2.0",
    "@types/react-router-dom": "5.3.3",
    "electron-log": "^5.4.3",
    "file-saver": "2.0.5",
    "googleapis": "150.0.1",
    "html2canvas": "1.4.1",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "immer": "10.1.3",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.7",
    "lucide-react": "0.417.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "2.6.0",
    "react-i18next": "^16.5.3",
    "react-router-dom": "7.12.0",
    "use-sync-external-store": "^1.5.0",
    "zundo": "2.3.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/file-saver": "2.0.7",
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.5.0",
    "autoprefixer": "10.4.21",
    "concurrently": "8.2.2",
    "cross-env": "^10.1.0",
    "electron": "39.8.5",
    "electron-builder": "26.8.1",
    "i18next-parser": "9.3.0",
    "postcss": "8.5.14",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.3",
    "vite": "6.4.2",
    "wait-on": "7.2.0"
  },
  "build": {
    "asar": true,
    "appId": "com.gestorevents.app",
    "productName": "GestorEsdevenimentsPersonal",
    "directories": {
      "output": "releases"
    },
    "fileAssociations": [
      {
        "ext": "gep",
        "name": "Document Gestor Esdeveniments",
        "role": "Editor"
      }
    ],
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "metadata.json",
      "google-credentials.json",
      "service-account.json"
    ],
    "extraResources": [
      {
        "from": "examples json",
        "to": "examples json"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "DEVELOPING.md",
        "to": "DEVELOPING.md"
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "artifactName": "GEP_v${version}-${env.BRANCH_NAME}-build${env.BUILD_NUMBER}-Linux-Ubuntu18.04+.${ext}",
      "asarUnpack": ["node_modules/**/*"]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico",
      "artifactName": "GEP_v${version}-${env.BRANCH_NAME}-build${env.BUILD_NUMBER}-Windows-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "public/icon.icns",
      "identity": null,
      "artifactName": "GEP_v${version}-${env.BRANCH_NAME}-build${env.BUILD_NUMBER}-macOS-10.15+.${ext}"
    }
  }
}
