{
  "name": "@gep/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "npm run build:theme --workspace=@gep/desktop && expo start",
    "start:clear": "npm run build:theme --workspace=@gep/desktop && expo start -- --clear",
    "android": "npm run build:theme --workspace=@gep/desktop && expo run:android",
    "ios": "npm run build:theme --workspace=@gep/desktop && expo run:ios",
    "web": "npm run build:theme --workspace=@gep/desktop && expo start --web",
    "build:android-dev": "npm run build:theme --workspace=@gep/desktop && npx eas build --platform android --profile poc --local"
  },
  "dependencies": {
    "@gep/core": "file:../core",
    "expo": "~54.0.22",
    "expo-asset": "^12.0.9",
    "expo-file-system": "^19.0.17",
    "expo-status-bar": "~3.0.8",
    "react": "18.3.1",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "~5.9.2"
  },
  "private": true
}