---
// Download component with dynamic platform-specific download buttons
import GithubReleases from './GithubReleases';

interface DownloadProps {
  label: string;
  title: string;
  description: string;
  versionInfoTitle: string;
  versionInfoDescription: string;
  limitationsTitle: string;
  limitation1: string;
  limitation2: string;
  recommendation: string;
  installationInstructions: string;
  windowsSetup: {
    title: string;
    availableVersions: string;
    installerTitle: string;
    installerDesc: string;
    portableTitle: string;
    portableDesc: string;
    securityNote: string;
  };
  macosSetup: {
    title: string;
    availableVersions: string;
    step1: string;
    step2: string;
    step3: string;
    step4: string;
    step5: string;
    securityTitle: string;
    securityDescription: string;
    standardMethod: string;
    standardStep1: string;
    standardStep2: string;
    standardStep3: string;
    advancedMethod: string;
    optionA: string;
    optionB: string;
    terminalCommandDesc: string;
    firstTimeOnly: string;
  };
  linuxSetup: {
    title: string;
    step1: string;
    step2: string;
    step3: string;
    fuseNotePrefix: string;
    fuseNoteCommand: string;
  };
  otherVersions: {
    title: string;
    description: string;
    button: string;
  };
  requirementsSection: {
    title: string;
    minimum: string;
    recommended: string;
    cpuMin: string;
    ramMin: string;
    diskMin: string;
    cpuRec: string;
    ramRec: string;
    diskRec: string;
  };
  sourceCodeGithub: string;
}

const {
  label,
  title,
  description,
  versionInfoTitle,
  versionInfoDescription,
  limitationsTitle,
  limitation1,
  limitation2,
  recommendation,
  installationInstructions,
  windowsSetup,
  macosSetup,
  linuxSetup,
  otherVersions,
  requirementsSection,
  sourceCodeGithub
}: DownloadProps = Astro.props;
---

<section id="download" class="py-20 bg-gray-900 border-t border-gray-800">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto text-center">
      <span class="inline-block bg-blue-500/10 text-blue-400 text-sm font-medium px-4 py-1.5 rounded-full mb-4 border border-blue-500/20">
        {label}
      </span>
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">{title}</h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto mb-6">
        {description}
      </p>

      <!-- Avis sobre versions -->
      <div class="bg-blue-900/20 border-l-4 border-blue-500 p-4 rounded-lg mb-8 max-w-3xl mx-auto">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h2a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-blue-100">{versionInfoTitle}</h3>
            <div class="mt-2 text-sm text-blue-200 space-y-2 text-left">
              <p>{versionInfoDescription}</p>
              <p class="font-medium">{limitationsTitle}</p>
              <ul class="list-disc pl-5 space-y-1">
                <li>{limitation1}</li>
                <li>{limitation2}</li>
              </ul>
              <p>{recommendation}</p>
            </div>
          </div>
        </div>
      </div>

      <GithubReleases client:load />

      <!-- Instruccions d'instal·lació -->
      <div class="mt-16 bg-gray-800 rounded-2xl p-8 max-w-4xl mx-auto border border-gray-700 shadow-sm">
        <h3 class="text-2xl font-bold mb-6 text-white">📥 {installationInstructions}</h3>
        
        <!-- Windows -->
        <div class="mb-8">
          <h4 class="text-xl font-semibold mb-3 text-white flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/>
            </svg>
            {windowsSetup.title}
          </h4>
          <div class="pl-8 text-left">
            <p class="text-gray-300 mb-3">{windowsSetup.availableVersions}</p>
            <ul class="list-disc pl-5 space-y-2 text-gray-400">
              <li><span class="font-medium">{windowsSetup.installerTitle}</span> {windowsSetup.installerDesc}</li>
              <li><span class="font-medium">{windowsSetup.portableTitle}</span> {windowsSetup.portableDesc}</li>
            </ul>
            <div class="mt-4 p-4 bg-blue-900/20 border-l-4 border-blue-500 rounded-r">
              <p class="text-blue-200 text-sm">{windowsSetup.securityNote}</p>
            </div>
          </div>
        </div>

        <!-- macOS -->
        <div class="mb-8 text-left">
          <h4 class="text-xl font-semibold mb-3 text-white flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.16-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            {macosSetup.title}
          </h4>
          <div class="pl-8">
            <p class="text-gray-300 mb-3">{macosSetup.availableVersions}</p>
            <ol class="list-decimal pl-5 space-y-2 text-gray-400">
              <li>{macosSetup.step1}</li>
              <li>{macosSetup.step2}</li>
              <li>{macosSetup.step3}</li>
              <li>{macosSetup.step4}</li>
              <li>{macosSetup.step5}</li>
            </ol>
            <div class="mt-4 p-4 bg-amber-900/20 border-l-4 border-amber-500 rounded-r">
              <h4 class="text-amber-200 font-medium mb-2">{macosSetup.securityTitle}</h4>
              <p class="text-amber-100 text-sm mb-2">
                {macosSetup.securityDescription}
              </p>
              
              <h5 class="text-amber-100 font-medium text-sm mt-3 mb-1">{macosSetup.standardMethod}</h5>
              <ol class="list-decimal pl-5 space-y-1 text-amber-100 text-sm">
                <li>{macosSetup.standardStep1}</li>
                <li>{macosSetup.standardStep2}</li>
                <li>{macosSetup.standardStep3}</li>
              </ol>

              <div class="mt-3 pt-3 border-t border-amber-500/30">
                <h5 class="text-amber-100 font-medium text-sm mb-1">{macosSetup.advancedMethod}</h5>
                <p class="text-amber-100 text-xs mb-2"><strong>{macosSetup.optionA.split(':')[0]}:</strong>{macosSetup.optionA.split(':')[1]}</p>
                <p class="text-amber-100 text-xs"><strong>{macosSetup.optionB.split(':')[0]}:</strong>{macosSetup.optionB.split(':')[1]}<br>
                <code class="bg-amber-900/50 px-2 py-1 rounded mt-1 inline-block">{macosSetup.terminalCommandDesc}</code></p>
              </div>
              
              <p class="text-amber-100 text-xs mt-3 italic">
                {macosSetup.firstTimeOnly}
              </p>
            </div>
          </div>
        </div>

        <!-- Linux -->
        <div class="mb-6 text-left">
          <h4 class="text-xl font-semibold mb-3 text-white flex items-center">
            <svg role="img" class="h-6 w-6 mr-2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <title>Linux</title>
              <path fill="#fffff" d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 0 0-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 0 0-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139zm.529 3.405h.013c.213 0 .396.062.584.198.19.135.33.332.438.533.105.259.158.459.166.724 0-.02.006-.04.006-.06v.105a.086.086 0 0 1-.004-.021l-.004-.024a1.807 1.807 0 0 1-.15.706.953.953 0 0 1-.213.335.71.71 0 0 0-.088-.042c-.104-.045-.198-.064-.284-.133a1.312 1.312 0 0 0-.22-.066c.05-.06.146-.133.183-.198.053-.128.082-.264.088-.402v-.02a1.21 1.21 0 0 0-.061-.4c-.045-.134-.101-.2-.183-.333-.084-.066-.167-.132-.267-.132h-.016c-.093 0-.176.03-.262.132a.8.8 0 0 0-.205.334 1.18 1.18 0 0 0-.09.4v.019c.002.089.008.179.02.267-.193-.067-.438-.135-.607-.202a1.635 1.635 0 0 1-.018-.2v-.02a1.772 1.772 0 0 1 .15-.768c.082-.22.232-.406.43-.533a.985.985 0 0 1 .594-.2zm-2.962.059h.036c.142 0 .27.048.399.135.146.129.264.288.344.465.09.199.14.4.153.667v.004c.007.134.006.2-.002.266v.08c-.03.007-.056.018-.083.024-.152.055-.274.135-.393.2.012-.09.013-.18.003-.267v-.015c-.012-.133-.04-.2-.082-.333a.613.613 0 0 0-.166-.267.248.248 0 0 0-.183-.064h-.021c-.071.006-.13.04-.186.132a.552.552 0 0 0-.12.27.944.944 0 0 0-.023.33v.015c.012.135.037.2.08.334.046.134.098.2.166.268.01.009.02.018.034.024-.07.057-.117.07-.176.136a.304.304 0 0 1-.131.068 2.62 2.62 0 0 1-.275-.402 1.772 1.772 0 0 1-.155-.667 1.759 1.759 0 0 1 .08-.668 1.43 1.43 0 0 1 .283-.535c.128-.133.26-.2.418-.2zm1.37 1.706c.332 0 .733.065 1.216.399.293.2.523.269 1.052.468h.003c.255.136.405.266.478.399v-.131a.571.571 0 0 1 .016.47c-.123.31-.516.643-1.063.842v.002c-.268.135-.501.333-.775.465-.276.135-.588.292-1.012.267a1.139 1.139 0 0 1-.448-.067 3.566 3.566 0 0 1-.322-.198c-.195-.135-.363-.332-.612-.465v-.005h-.005c-.4-.246-.616-.512-.686-.71-.07-.268-.005-.47.193-.6.224-.135.38-.271.483-.336.104-.074.143-.102.176-.131h.002v-.003c.169-.202.436-.47.839-.601.139-.036.294-.065.466-.065zm2.8 2.142c.358 1.417 1.196 3.475 1.735 4.473.286.534.855 1.659 1.102 3.024.156-.005.33.018.513.064.646-1.671-.546-3.467-1.089-3.966-.22-.2-.232-.335-.123-.335.59.534 1.365 1.572 1.646 2.757.13.535.16 1.104.021 1.67.067.028.135.06.205.067 1.032.534 1.413.938 1.23 1.537v-.043c-.06-.003-.12 0-.18 0h-.016c.151-.467-.182-.825-1.065-1.224-.915-.4-1.646-.336-1.77.465-.008.043-.013.066-.018.135-.068.023-.139.053-.209.064-.43.268-.662.669-.793 1.187-.13.533-.17 1.156-.205 1.869v.003c-.02.334-.17.838-.319 1.35-1.5 1.072-3.58 1.538-5.348.334a2.645 2.645 0 0 0-.402-.533 1.45 1.45 0 0 0-.275-.333c.182 0 .338-.03.465-.067a.615.615 0 0 0 .314-.334c.108-.267 0-.697-.345-1.163-.345-.467-.931-.995-1.788-1.521-.63-.4-.986-.87-1.15-1.396-.165-.534-.143-1.085-.015-1.645.245-1.07.873-2.11 1.274-2.763.107-.065.037.135-.408.974-.396.751-1.14 2.497-.122 3.854a8.123 8.123 0 0 1 .647-2.876c.564-1.278 1.743-3.504 1.836-5.268.048.036.217.135.289.202.218.133.38.333.59.465.21.201.477.335.876.335.039.003.075.006.11.006.412 0 .73-.134.997-.268.29-.134.52-.334.74-.4h.005c.467-.135.835-.402 1.044-.7zm2.185 8.958c.037.6.343 1.245.882 1.377.588.134 1.434-.333 1.791-.765l.211-.01c.315-.007.577.01.847.268l.003.003c.208.199.305.53.391.876.085.4.154.78.409 1.066.486.527.645.906.636 1.14l.003-.007v.018l-.003-.012c-.015.262-.185.396-.498.595-.63.401-1.746.712-2.457 1.57-.618.737-1.37 1.14-2.036 1.191-.664.053-1.237-.2-1.574-.898l-.005-.003c-.21-.4-.12-1.025.056-1.69.176-.668.428-1.344.463-1.897.037-.714.076-1.335.195-1.814.12-.465.308-.797.641-.984l.045-.022zm-10.814.049h.01c.053 0 .105.005.157.014.376.055.706.333 1.023.752l.91 1.664.003.003c.243.533.754 1.064 1.189 1.637.434.598.77 1.131.729 1.57v.006c-.057.744-.48 1.148-1.125 1.294-.645.135-1.52.002-2.395-.464-.968-.536-2.118-.469-2.857-.602-.369-.066-.61-.2-.723-.4-.11-.2-.113-.602.123-1.23v-.004l.002-.003c.117-.334.03-.752-.027-1.118-.055-.401-.083-.71.043-.94.16-.334.396-.4.69-.533.294-.135.64-.202.915-.47h.002v-.002c.256-.268.445-.601.668-.838.19-.201.38-.336.663-.336zm7.159-9.074c-.435.201-.945.535-1.488.535-.542 0-.97-.267-1.28-.466-.154-.134-.28-.268-.373-.335-.164-.134-.144-.333-.074-.333.109.016.129.134.199.2.096.066.215.2.36.333.292.2.68.467 1.167.467.485 0 1.053-.267 1.398-.466.195-.135.445-.334.648-.467.156-.136.149-.267.279-.267.128.016.034.134-.147.332a8.097 8.097 0 0 1-.69.468zm-1.082-1.583V5.64c-.006-.02.013-.042.029-.05.074-.043.18-.027.26.004.063 0 .16.067.15.135-.006.049-.085.066-.135.066-.055 0-.092-.043-.141-.068-.052-.018-.146-.008-.163-.065zm-.551 0c-.02.058-.113.049-.166.066-.047.025-.086.068-.14.068-.05 0-.13-.02-.136-.068-.01-.066.088-.133.15-.133.08-.031.184-.047.259-.005.019.009.036.03.03.05v.02h.003z"/>
            </svg>
            {linuxSetup.title}
          </h4>
          <div class="pl-8">
            <ol class="list-decimal pl-5 space-y-2 text-gray-400">
              <li>{linuxSetup.step1}</li>
              <li>{linuxSetup.step2}</li>
              <li>{linuxSetup.step3}</li>
            </ol>
            <div class="mt-4 p-4 bg-purple-900/20 border-l-4 border-purple-500 rounded-r">
              <p class="text-purple-200 text-sm">{linuxSetup.fuseNotePrefix}<code class="bg-gray-700 px-1.5 py-0.5 rounded">{linuxSetup.fuseNoteCommand}</code></p>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 bg-gray-800 rounded-2xl p-8 max-w-3xl mx-auto border border-gray-700 shadow-sm">
        <div class="flex flex-col md:flex-row items-center">
          <div class="md:w-2/3 md:pr-8 mb-6 md:mb-0 text-left">
            <h3 class="text-xl font-semibold mb-3 text-white">{otherVersions.title}</h3>
            <p class="text-gray-400">
              {otherVersions.description}
            </p>
          </div>
          <div class="md:w-1/3">
            <a 
              href="https://github.com/Pepelocotango/Gestor-Events_i_Personal/releases" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center w-full px-6 py-3 border border-gray-600 text-gray-300 font-medium rounded-lg hover:bg-gray-700 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              {otherVersions.button}
            </a>
          </div>
        </div>
      </div>

      <!-- System Requirements -->
      <div class="mt-16 text-left max-w-4xl mx-auto">
        <h3 class="text-2xl font-bold mb-6 text-white">{requirementsSection.title}</h3>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-gray-800 p-6 rounded-xl border border-gray-700">
            <h4 class="font-semibold text-lg mb-3 text-white flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {requirementsSection.minimum}
            </h4>
            <ul class="space-y-2 text-gray-400">
              <li class="flex items-start">
                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {requirementsSection.cpuMin}
              </li>
              <li class="flex items-start">
                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {requirementsSection.ramMin}
              </li>
              <li class="flex items-start">
                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {requirementsSection.diskMin}
              </li>
            </ul>
          </div>
          <div class="bg-gray-800 p-6 rounded-xl border border-gray-700">
            <h4 class="font-semibold text-lg mb-3 text-white flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              {requirementsSection.recommended}
            </h4>
            <ul class="space-y-2 text-gray-400">
              <li class="flex items-start">
                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {requirementsSection.cpuRec}
              </li>
              <li class="flex items-start">
                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {requirementsSection.ramRec}
              </li>
              <li class="flex items-start">
                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {requirementsSection.diskRec}
              </li>              
            </ul>
          </div>
        </div>
      </div>
      
      <!-- GitHub Link -->
      <div class="mt-12 text-center">
        <a 
          href="https://github.com/Pepelocotango/Gestor-Events_i_Personal" 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 border border-gray-600 text-gray-300 font-medium rounded-lg hover:bg-gray-800 transition-colors"
