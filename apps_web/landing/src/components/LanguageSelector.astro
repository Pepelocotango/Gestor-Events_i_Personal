---
interface Props {
  currentLocale: string;
  currentPath: string;
}

const { currentLocale, currentPath } = Astro.props;

const languages = [
  { code: 'ca', name: 'Català', flag: '🏴' },
  { code: 'es', name: 'Español', flag: '🇪🇸' },
  { code: 'en', name: 'English', flag: '🇬🇧' },
];

function getLocalizedPath(path: string, targetLocale: string): string {
  const segments = path.split('/').filter(Boolean);
  
  // Remove current locale if present
  if (['ca', 'es', 'en'].includes(segments[0])) {
    segments.shift();
  }
  
  // Add target locale if not default (ca)
  if (targetLocale !== 'ca') {
    segments.unshift(targetLocale);
  }
  
  return '/' + segments.join('/');
}
---

<div class="language-selector">
  {languages.map((lang) => (
    <a
      href={getLocalizedPath(currentPath, lang.code)}
      class={`language-option ${currentLocale === lang.code ? 'active' : ''}`}
      title={lang.name}
    >
      <span class="flag">{lang.flag}</span>
      <span class="name">{lang.code.toUpperCase()}</span>
    </a>
  ))}
</div>

<style>
  .language-selector {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 0.5rem;
    padding: 0.25rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .language-option {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.8);
    transition: all 0.2s ease;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .language-option:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .language-option.active {
    background: rgba(59, 130, 246, 0.5);
    color: white;
  }

  .flag {
    font-size: 1rem;
  }

  .name {
    font-family: system-ui, -apple-system, sans-serif;
  }

  @media (max-width: 640px) {
    .language-selector {
      gap: 0.25rem;
      padding: 0.125rem;
    }

    .language-option {
      padding: 0.375rem 0.5rem;
      font-size: 0.75rem;
    }

    .name {
      display: none;
    }
  }
</style>
