---
const { currentLang } = Astro.props;

const languages = [
  { code: 'ca', label: 'Català', path: '' },
  { code: 'es', label: 'Castellà', path: 'es/' },
  { code: 'en', label: 'English', path: 'en/' },
];

const currentLanguage = languages.find(l => l.code === currentLang) || languages[0];

// Helper per calcular la URL de destinació mantenint la subpàgina
const getTargetUrl = (targetPath: string) => {
  const url = new URL(Astro.request.url);
  const pathname = url.pathname;
  
  // Eliminar el prefix d'idioma actual si existeix
  let baseContentPath = pathname;
  if (pathname.startsWith('/es/')) {
    baseContentPath = pathname.replace('/es/', '/');
  } else if (pathname.startsWith('/en/')) {
    baseContentPath = pathname.replace('/en/', '/');
  } else if (pathname.startsWith('/ca/')) {
    baseContentPath = pathname.replace('/ca/', '/');
  }
  
  // Assegurar que el path de contingut no comenci per / duplicat
  const cleanContentPath = baseContentPath.startsWith('/') ? baseContentPath.slice(1) : baseContentPath;
  
  // Construir la nova URL
  // Si el path de destinació és buit (català), no afegir prefix per a la pàgina principal
  // Per a la resta, sempre afegir el prefix d'idioma
  if (targetPath === '' && cleanContentPath === '') {
    return '/';
  }
  
  // Per a gep-mailer, sempre afegir el prefix d'idioma excepte per a la ruta arrel
  if (cleanContentPath === 'gep-mailer') {
    return targetPath === '' ? '/gep-mailer' : `/${targetPath}gep-mailer`;
  }
  
  return `/${targetPath}${cleanContentPath}`;
};
---

<div class="relative inline-block text-left language-selector-container">
  <div>
    <button
      type="button"
      class="inline-flex items-center justify-center w-full rounded-md border border-white/10 shadow-sm px-4 py-2 bg-white/5 backdrop-blur-sm text-sm font-medium text-white hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-900 focus:ring-white transition-all gap-2"
      aria-expanded="false"
      aria-haspopup="true"
      data-language-button
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-80">
        <circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20"/><path d="M2 12h20"/><path d="M12 2a14.5 14.5 0 0 1 0 20"/><path d="M12 2a14.5 14.5 0 0 0 0 20"/><path d="M2 12h20"/><path d="M12 2a14.5 14.5 0 0 1 0 20"/>
        <line x1="2" y1="12" x2="22" y2="12"/><line x1="12" y1="2" x2="12" y2="22"/><path d="M12 2a14.5 14.5 0 0 0 0 20"/><path d="M12 2a14.5 14.5 0 0 1 0 20"/>
      </svg>
      <span class="uppercase">{currentLang}</span>
      <svg class="-mr-1 ml-1 h-4 w-4 opacity-60" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>
  </div>

  <div
    class="hidden origin-top-right absolute right-0 mt-2 w-40 rounded-md shadow-lg bg-[#1a1a1a] border border-white/10 ring-1 ring-black ring-opacity-5 focus:outline-none z-50 transition-all"
    role="menu"
    aria-orientation="vertical"
    data-language-dropdown
  >
    <div class="py-1" role="none">
      {languages.map((lang) => (
        <a
          href={getTargetUrl(lang.path)}
          class={`block px-4 py-2 text-sm transition-colors ${
            currentLang === lang.code
              ? 'bg-white/10 text-white font-semibold'
              : 'text-gray-300 hover:bg-white/5 hover:text-white'
          }`}
          role="menuitem"
        >
          {lang.label}
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  function setupLanguageSelectors() {
    const containers = document.querySelectorAll('.language-selector-container');

    containers.forEach(container => {
      const button = container.querySelector('[data-language-button]');
      const dropdown = container.querySelector('[data-language-dropdown]');

      if (!button || !dropdown) return;

      const toggleDropdown = (show?: boolean) => {
        const isHidden = dropdown.classList.contains('hidden');
        const shouldShow = show !== undefined ? show : isHidden;

        if (shouldShow) {
          dropdown.classList.remove('hidden');
          button.setAttribute('aria-expanded', 'true');
        } else {
          dropdown.classList.add('hidden');
          button.setAttribute('aria-expanded', 'false');
        }
      };

      button.addEventListener('click', (e) => {
        e.stopPropagation();
        // Tancar altres dropdowns abans d'obrir aquest
        document.querySelectorAll('[data-language-dropdown]').forEach(other => {
          if (other !== dropdown) other.classList.add('hidden');
        });
        document.querySelectorAll('[data-language-button]').forEach(other => {
          if (other !== button) other.setAttribute('aria-expanded', 'false');
        });

        toggleDropdown();
      });

      // Tancar en fer clic a fora
      document.addEventListener('click', (e) => {
        if (!container.contains(e.target as Node)) {
          toggleDropdown(false);
        }
      });

      // Tancar en prémer Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          toggleDropdown(false);
        }
      });
    });
  }

  // Executar en carregar la pàgina
  setupLanguageSelectors();

  // Re-executar si hi ha navegació SPA (Astro View Transitions)
  document.addEventListener('astro:after-swap', setupLanguageSelectors);
</script>
