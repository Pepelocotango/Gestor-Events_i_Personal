---
// Features component to showcase the main features
interface FeaturesProps {
  label: string;
  title: string;
  description: string;
  privacyTitle: string;
  privacyDescription: string;
  teamManagementTitle: string;
  teamManagementDescription: string;
  techSheetsTitle: string;
  techSheetsDescription: string;
  inventoryTitle: string;
  inventoryDescription: string;
  googleIntegrationTitle: string;
  googleIntegrationDescription: string;
  betaTag: string;
  openSourceTitle: string;
  openSourceDescription: string;
  ctaTitle: string;
  ctaDescription: string;
  ctaButtonStart: string;
  ctaButtonGithub: string;
}

const {
  label,
  title,
  description,
  privacyTitle,
  privacyDescription,
  teamManagementTitle,
  teamManagementDescription,
  techSheetsTitle,
  techSheetsDescription,
  inventoryTitle,
  inventoryDescription,
  googleIntegrationTitle,
  googleIntegrationDescription,
  betaTag,
  openSourceTitle,
  openSourceDescription,
  ctaTitle,
  ctaDescription,
  ctaButtonStart,
  ctaButtonGithub
}: FeaturesProps = Astro.props;
---

<section id="features" class="py-20 bg-gray-900">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-1.5 text-sm font-medium text-cyan-400 bg-cyan-900/30 rounded-full mb-4">
        {label}
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{title}</h2>
      <p class="text-lg text-gray-400">
        {description}
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      <!-- Feature 1: Privadesa -->
      <div class="group p-6 rounded-xl border border-gray-700 bg-gray-800 hover:border-brand-500/30 transition-colors">
        <div class="w-12 h-12 rounded-lg bg-emerald-500/10 flex items-center justify-center text-emerald-400 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-3 text-white">{privacyTitle}</h3>
        <p class="text-gray-400 leading-relaxed">
          {privacyDescription}
        </p>
      </div>

      <!-- Feature 2: Gestió d'Equips -->
      <div class="group p-6 rounded-xl border border-gray-700 bg-gray-800 hover:border-brand-500/30 transition-colors">
        <div class="w-12 h-12 rounded-lg bg-purple-500/10 flex items-center justify-center text-purple-400 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-3 text-white">{teamManagementTitle}</h3>
        <p class="text-gray-400 leading-relaxed">
          {teamManagementDescription}
        </p>
      </div>

      <!-- Feature 3: Fitxes de Bolo -->
      <div class="group p-6 rounded-xl border border-gray-700 bg-gray-800 hover:border-brand-500/30 transition-colors">
        <div class="w-12 h-12 rounded-lg bg-cyan-500/10 flex items-center justify-center text-cyan-400 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-3 text-white">{techSheetsTitle}</h3>
        <p class="text-gray-400 leading-relaxed">
          {techSheetsDescription}
        </p>
      </div>

      <!-- Feature 4: Control d'Estoc -->
      <div class="group p-6 rounded-xl border border-gray-700 bg-gray-800 hover:border-brand-500/30 transition-colors">
        <div class="w-12 h-12 rounded-lg bg-amber-500/10 flex items-center justify-center text-amber-400 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m0 0l8 4m-8-4v10l8 4m0-10l8 4m-8-4v10" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-3 text-white">{inventoryTitle}</h3>
        <p class="text-gray-400 leading-relaxed">
          {inventoryDescription}
        </p>
      </div>

      <!-- Feature 5: Google -->
      <div class="group p-6 rounded-xl border border-gray-700 bg-gray-800 hover:border-brand-500/30 transition-colors">
        <div class="w-12 h-12 rounded-lg bg-brand-500/10 flex items-center justify-center text-brand-400 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="flex items-center gap-2 mb-3">
          <h3 class="text-xl font-semibold text-white">{googleIntegrationTitle}</h3>
          <span class="inline-block px-2 py-1 text-xs font-bold bg-amber-500/20 text-amber-300 rounded-full border border-amber-500/30">{betaTag}</span>
        </div>
        <p class="text-gray-400 leading-relaxed">
          {googleIntegrationDescription}
        </p>
      </div>

      <!-- Feature 6: Codi Obert -->
      <div class="group p-6 rounded-xl border border-gray-700 bg-gray-800 hover:border-brand-500/30 transition-colors">
        <div class="w-12 h-12 rounded-lg bg-pink-500/10 flex items-center justify-center text-pink-400 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold mb-3 text-white">{openSourceTitle}</h3>
        <p class="text-gray-400 leading-relaxed">
          {openSourceDescription}
        </p>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="mt-20 bg-gradient-to-r from-brand-600 to-cyan-500 rounded-2xl p-8 md:p-12 text-center text-white relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent"></div>
      <div class="relative z-10">
        <h3 class="text-2xl md:text-3xl font-bold mb-4">{ctaTitle}</h3>
        <p class="text-blue-100 text-lg mb-8 max-w-2xl mx-auto">
          {ctaDescription}
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="#download" class="inline-flex items-center justify-center px-8 py-4 bg-white text-gray-900 font-semibold rounded-xl hover:bg-gray-100 transition-all duration-300 shadow-lg hover:shadow-xl hover:shadow-brand-500/20">
            {ctaButtonStart}
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
          <a href="https://github.com/Pepelocotango/Gestor-Events_i_Personal" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 bg-white/10 backdrop-blur-sm border-2 border-white/20 text-white font-semibold rounded-xl hover:bg-white/20 hover:border-white/30 transition-all duration-300">
            {ctaButtonGithub}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
