---
// Gallery component to showcase app screenshots
---

<section id="gallery" class="py-20 bg-gray-800">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Galeria d'imatges</h2>
      <p class="text-gray-400 max-w-2xl mx-auto">
        Descobreix l'aplicació d'escriptori i mòbil a través d'aquestes captures de pantalla
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Desktop Screenshots -->
      <div>
        <h3 class="text-xl font-semibold mb-4 text-center md:text-left">Versió d'escriptori</h3>
        <div class="space-y-6">
          <div class="bg-gray-900 rounded-xl overflow-hidden shadow-xl">
            <div class="bg-gray-700 h-8 flex items-center px-4 space-x-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
            <img 
              src="/images/desktop-dashboard.png" 
              alt="Panell principal de l'aplicació d'escriptori"
              class="w-full h-auto border-t border-gray-700"
              loading="lazy"
            />
            <div class="p-4 text-sm text-gray-400 text-center">
              Panell principal amb visió general dels esdeveniments
            </div>
          </div>

          <div class="bg-gray-900 rounded-xl overflow-hidden shadow-xl">
            <div class="bg-gray-700 h-8 flex items-center px-4 space-x-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
            </div>
            <img 
              src="/images/desktop-event.png" 
              alt="Detall d'esdeveniment"
              class="w-full h-auto border-t border-gray-700"
              loading="lazy"
            />
            <div class="p-4 text-sm text-gray-400 text-center">
              Detall d'un esdeveniment amb totes les seves dades
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile Screenshots -->
      <div>
        <h3 class="text-xl font-semibold mb-4 text-center md:text-left">Versió mòbil</h3>
        <div class="flex justify-center">
          <div class="w-64">
            <div class="bg-black rounded-3xl p-2 shadow-2xl border-4 border-gray-800">
              <!-- Status Bar -->
              <div class="flex justify-between items-center px-4 py-1">
                <span class="text-white text-xs font-bold">14:30</span>
                <div class="flex space-x-1">
                  <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17 4a5 5 0 015 5v6a5 5 0 01-5 5H7a5 5 0 01-5-5V9a5 5 0 015-5h10zm0 2H7a3 3 0 00-3 3v6a3 3 0 003 3h10a3 3 0 003-3V9a3 3 0 00-3-3zm-8 4a1 1 0 011 1v2a1 1 0 01-2 0v-2a1 1 0 011-1zm8 0a1 1 0 011 1v2a1 1 0 01-2 0v-2a1 1 0 011-1zm-4 0a1 1 0 011 1v2a1 1 0 01-2 0v-2a1 1 0 011-1z" />
                  </svg>
                  <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5c0-1.1.9-2 2-2zm7 16a5 5 0 100-10 5 5 0 000 10z" />
                  </svg>
                  <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M16 8a6 6 0 010 12H8a6 6 0 110-12h8zm0 2H8a4 4 0 100 8h8a4 4 0 000-8z" />
                  </svg>
                </div>
              </div>
              
              <!-- Mobile Screenshot -->
              <div class="relative rounded-xl overflow-hidden bg-gray-900">
                <img 
                  src="/images/mobile-home.png" 
                  alt="Pantalla principal de l'aplicació mòbil"
                  class="w-full h-auto"
                  loading="lazy"
                />
                <div class="absolute bottom-0 left-0 right-0 bg-black bg-opacity-70 text-white text-xs text-center py-1">
                  Llista d'esdeveniments
                </div>
              </div>
              
              <!-- Home Indicator -->
              <div class="flex justify-center py-2">
                <div class="w-1/3 h-1 bg-gray-600 rounded-full"></div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="mt-8 grid grid-cols-2 gap-4 max-w-md mx-auto">
          <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg">
            <img 
              src="/images/mobile-calendar.png" 
              alt="Calendari de l'aplicació mòbil"
              class="w-full h-auto"
              loading="lazy"
            />
            <div class="p-2 text-xs text-gray-400 text-center">
              Vista de calendari
            </div>
          </div>
          <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg">
            <img 
              src="/images/mobile-material.png" 
              alt="Control de material"
              class="w-full h-auto"
              loading="lazy"
            />
            <div class="p-2 text-xs text-gray-400 text-center">
              Control d'estoc
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
