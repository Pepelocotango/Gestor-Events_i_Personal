---
// Gallery component to showcase app screenshots
const imageFiles = [
  '01_PantallaInici_clar.png',
  '01_PantallaInici_fosc.png',
  '02_vistaCalendari_clar.png',
  '02_vistaCalendari_fosc.png',
  '03_llistaEvents_clar.png',
  '03_llistaEvents_fosc.png',
  '04_resums_clar.png',
  '04_resums_fosc.png',
  '05_detalls_clar.png',
  '05_detalls_fosc.png',
  '06_novaAssignació_clar.png',
  '06_novaAssignació_fosc.png',
  '07_nouMarc_clar.png',
  '07_nouMarc_fosc.png',
  '08_editar_marc_clar.png',
  '08_editar_marc_fosc.png',
  '09_arxivar_clar.png',
  '09_arxivar_fosc.png',
  '10_configCal_clar.png',
  '10_configCal_fosc.png',
  '21_fitxesdebolo_clar.png',
  '21_fitxesdebolo_fosc.png',
  '22_FB_info_clar.png',
  '22_vistaPrevia_clar.png',
  '23_PersonalTecnic_clar.png',
  '24_FBhoraris_clar.png',
  '25_FBnecesitatsTec_clar.png',
  '31_Persones_clar.png',
  '31_persones_fosc.png',
  '41_centreControlMaterial_clar.png',
  '41_centreControlMaterial_fosc.png',
  '41_material_clar.png',
  '41_material_fosc.png',
  '51_About_clar.png',
  'desktop-dashboard.png',
  'grid.svg',
  'under-construction.png'
];

// Function to get a human-readable title from filename
const getImageTitle = (filename) => {
  // Remove file extension
  let title = filename.replace(/\.[^/.]+$/, '');
  // Replace underscores with spaces
  title = title.replace(/_/g, ' ');
  // Capitalize first letter of each word
  return title.split(' ').map(word => 
    word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()
  ).join(' ');
};
---

<section id="gallery" class="py-12 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <span class="inline-block bg-blue-100 text-blue-800 text-sm font-medium px-4 py-1.5 rounded-full mb-4 border border-blue-200">
        Galeria d'imatges
      </span>
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-gray-900">Descobreix l'aplicació</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">
        Explora les diferents pantalles i funcionalitats del Gestor d'Esdeveniments i Personal
      </p>
      <div class="w-24 h-1.5 bg-gradient-to-r from-blue-500 to-cyan-500 mx-auto mt-4 rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {
        imageFiles.map((image) => (
          <div class="group bg-white rounded-xl border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow duration-300">
            <div class="aspect-w-16 aspect-h-9 overflow-hidden">
              <img 
                src={`/images/${image}`} 
                alt={getImageTitle(image)}
                class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-4 border-t border-gray-100">
              <h3 class="font-medium text-gray-900 truncate">{getImageTitle(image)}</h3>
              <p class="text-sm text-gray-500">
                {image.includes('_clar') ? 'Tema clar' : image.includes('_fosc') ? 'Tema fosc' : 'Imatge'}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

        <!-- Feature 3 -->
        <div class="bg-white rounded-xl border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow">
          <div class="p-1">
            <img 
              src="/images/under-construction.png" 
