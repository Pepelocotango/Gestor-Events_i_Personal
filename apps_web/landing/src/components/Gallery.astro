---
// Gallery component to showcase app screenshots
---

<section id="gallery" class="py-20 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <span class="inline-block bg-blue-100 text-blue-800 text-sm font-medium px-4 py-1.5 rounded-full mb-4 border border-blue-200">
        Captures de pantalla
      </span>
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-gray-900">Descobreix l'aplicació</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">
        Una ullada a com el Gestor d'Esdeveniments i Personal pot millorar el teu flux de treball
      </p>
      <div class="w-24 h-1.5 bg-gradient-to-r from-blue-500 to-cyan-500 mx-auto mt-4 rounded-full"></div>
    </div>

    <div class="max-w-5xl mx-auto">
      <!-- Main showcase -->
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100 mb-12">
        <div class="bg-gray-50 border-b border-gray-100 h-12 flex items-center px-4 space-x-2">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
          <div class="ml-2 text-sm text-gray-500 font-medium">Panell principal</div>
        </div>
        <div class="p-1">
          <img 
            src="/images/under-construction.png" 
            alt="Panell principal de l'aplicació"
            class="w-full h-auto rounded-lg border border-gray-100"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Feature grid -->
      <div class="grid md:grid-cols-3 gap-6 mb-12">
        <!-- Feature 1 -->
        <div class="bg-white rounded-xl border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow">
          <div class="p-1">
            <img 
              src="/images/under-construction.png" 
              alt="Calendari d'esdeveniments"
              class="w-full h-auto rounded-lg border border-gray-100"
              loading="lazy"
            />
          </div>
          <div class="p-4 border-t border-gray-100">
            <h3 class="font-semibold text-gray-900">Calendari d'esdeveniments</h3>
            <p class="text-sm text-gray-600 mt-1">Visualitza i gestiona tots els teus esdeveniments en un calendari intuïtiu</p>
          </div>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white rounded-xl border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow">
          <div class="p-1">
            <img 
              src="/images/under-construction.png" 
              alt="Gestió de personal"
              class="w-full h-auto rounded-lg border border-gray-100"
              loading="lazy"
            />
          </div>
          <div class="p-4 border-t border-gray-100">
            <h3 class="font-semibold text-gray-900">Gestió de personal</h3>
            <p class="text-sm text-gray-600 mt-1">Assigna i gestiona el teu equip de manera eficient</p>
          </div>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white rounded-xl border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow">
          <div class="p-1">
            <img 
              src="/images/under-construction.png" 
              alt="Control d'inventari"
              class="w-full h-auto rounded-lg border border-gray-100"
              loading="lazy"
            />
          </div>
          <div class="p-4 border-t border-gray-100">
            <h3 class="font-semibold text-gray-900">Control d'inventari</h3>
            <p class="text-sm text-gray-600 mt-1">Fes un seguiment del teu material i estoc en temps real</p>
          </div>
        </div>
      </div>

      <!-- Mobile showcase -->
      <div class="bg-gradient-to-r from-blue-50 to-cyan-50 rounded-2xl p-8 md:p-12">
        <div class="flex flex-col md:flex-row items-center">
          <div class="md:w-1/2 mb-8 md:mb-0 md:pr-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Aplicació mòbil inclosa</h3>
            <p class="text-gray-600 mb-6">
              Accedeix a la teva informació des de qualsevol lloc amb la nostra aplicació mòbil compatible amb iOS i Android.
              Tota la potència del teu gestor d'esdeveniments al teu butxac.
            </p>
            <div class="flex flex-col sm:flex-row space-y-3 sm:space-y-0 sm:space-x-4">
              <a href="#" class="inline-flex items-center justify-center px-5 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-gray-900 hover:bg-gray-800 transition-colors">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.15 2.25.9 3.1.96.85-.1 1.65-.7 2.1-1.15 1.1-1.2 2.4-1.2 3.1-1.3 2.8-.2 4.5 1.5 4.85 3.1-3.4 1.5-2.5 5.5.5 6.6-1.4 2.1-1.6 3.3-3.55 3.86zM12 7.1c.1-1.5 1.3-2.8 2.75-3.15-.25 1.1-.9 2.05-1.9 2.6-.9.5-1.85.85-2.85.7z"/>
                </svg>
                App Store
              </a>
              <a href="#" class="inline-flex items-center justify-center px-5 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-gray-900 hover:bg-gray-800 transition-colors">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M3.6 1.6h16.8v20.8H3.6V1.6zm8.4 9.5c0-.6.5-1.1 1.1-1.1h5.4c.6 0 1.1.5 1.1 1.1v.2c0 .6-.5 1.1-1.1 1.1h-5.4c-.6 0-1.1-.5-1.1-1.1v-.2z"/>
                </svg>
                Google Play
              </a>
            </div>
          </div>
          <div class="md:w-1/2 relative">
            <div class="relative z-10 max-w-xs mx-auto">
              <div class="bg-gray-900 rounded-3xl p-2 shadow-2xl border-4 border-gray-800">
                <!-- Status Bar -->
                <div class="flex justify-between items-center px-4 py-1">
                  <span class="text-white text-xs font-bold">14:30</span>
                  <div class="flex space-x-1">
                    <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17 4a5 5 0 015 5v6a5 5 0 01-5 5H7a5 5 0 01-5-5V9a5 5 0 015-5h10zm0 2H7a3 3 0 00-3 3v6a3 3 0 003 3h10a3 3 0 003-3V9a3 3 0 00-3-3zm-8 4a1 1 0 011 1v2a1 1 0 01-2 0v-2a1 1 0 011-1zm8 0a1 1 0 011 1v2a1 1 0 01-2 0v-2a1 1 0 011-1zm-4 0a1 1 0 011 1v2a1 1 0 01-2 0v-2a1 1 0 011-1z" />
                    </svg>
                    <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5c0-1.1.9-2 2-2zm7 16a5 5 0 100-10 5 5 0 000 10z" />
                    </svg>
                    <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M16 8a6 6 0 010 12H8a6 6 0 010-12h8zm0 2H8a4 4 0 100 8h8a4 4 0 000-8z" />
                    </svg>
                  </div>
                </div>
                
                <!-- Mobile Screenshot -->
                <div class="relative aspect-[9/19] bg-gradient-to-b from-blue-50 to-white flex items-center justify-center">
                  <div class="text-center p-4">
                    <div class="text-2xl font-bold text-gray-800 mb-2">Gestor d'Esdeveniments</div>
                    <div class="text-sm text-gray-600">Tota la teva gestió a la teva butxaca</div>
                  </div>
                </div>
                
                <!-- Home Indicator -->
                <div class="flex justify-center py-2">
                  <div class="w-1/3 h-1.5 bg-gray-700 rounded-full"></div>
                </div>
              </div>
            </div>
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-blue-200 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob"></div>
            <div class="absolute -bottom-8 -left-6 w-40 h-40 bg-cyan-200 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-2000"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
