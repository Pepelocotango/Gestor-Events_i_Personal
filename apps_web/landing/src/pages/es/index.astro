---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Features from '../../components/Features.astro';
import ProductTour from '../../components/ProductTour';
import Gallery from '../../components/Gallery.astro';
import Download from '../../components/Download.astro';
import LanguageSelector from '../../components/LanguageSelector.astro';
import I18nProvider from '../../components/I18nProvider.tsx';
import { getTranslations } from '../../i18n';

// Get translations for Spanish
const t = await getTranslations({ ...Astro, locale: 'es' });

// Page metadata
const title = t.hero.title;
const description = t.hero.subtitle;
---

<Layout title={title} description={description} currentLocale="es" currentPath="/es/" translations={{
  navigation: t.navigation,
  footer: t.footer,
  site: t.site
}}>
  <div class="relative">
    <!-- Hero Section -->
    <Hero 
      title={t.hero.title}
      subtitle={t.hero.subtitle}
      description={t.hero.description}
      ctaPrimary={t.hero.cta_primary}
      ctaSecondary={t.hero.cta_secondary}
      openSourceFree={t.hero.open_source_free}
      platformSupport={t.hero.platform_support}
      discoverMore={t.hero.discover_more}
      scrollDownAriaLabel={t.hero.scroll_down}
      loadingAnimation={t.hero.loading_animation}
    />
    
    <!-- Features Section -->
    <Features 
      label={t.features_section.label}
      title={t.features_section.title}
      description={t.features_section.description}
      privacyTitle={t.features_section.privacy_title}
      privacyDescription={t.features_section.privacy_description}
      teamManagementTitle={t.features_section.team_management_title}
      teamManagementDescription={t.features_section.team_management_description}
      techSheetsTitle={t.features_section.tech_sheets_title}
      techSheetsDescription={t.features_section.tech_sheets_description}
      inventoryTitle={t.features_section.inventory_title}
      inventoryDescription={t.features_section.inventory_description}
      googleIntegrationTitle={t.features_section.google_integration_title}
      googleIntegrationDescription={t.features_section.google_integration_description}
      betaTag={t.features_section.beta_tag}
      openSourceTitle={t.features.open_source.title}
      openSourceDescription={t.features.open_source.description}
      ctaTitle={t.features.cta.title}
      ctaDescription={t.features.cta.description}
      ctaButtonStart={t.features.cta.button_start}
      ctaButtonGithub={t.features.cta.button_github}
    />
    
    <!-- Product Tour -->
    <I18nProvider client:load initialLang="es">
      <ProductTour client:visible sections={t.tour_sections} />
    </I18nProvider>
    
    <!-- Gallery -->
    <Gallery 
      label={t.gallery.label}
      title={t.gallery.title}
      subtitle={t.gallery.subtitle}
    />
    
    <!-- Download Section -->
    <Download 
      label={t.download_section.label}
      title={t.download_section.title}
      description={t.download_section.description}
      versionInfoTitle={t.download_section.version_info_title}
      versionInfoDescription={t.download_section.version_info_description}
      limitationsTitle={t.download_section.limitations_title}
      limitation1={t.download_section.limitation_1}
      limitation2={t.download_section.limitation_2}
      recommendation={t.download_section.recommendation}
      installationInstructions={t.download.installation_instructions}
      windowsSetup={{
        title: t.download.windows_setup.title,
        availableVersions: t.download.windows_setup.available_versions,
        installerTitle: t.download.windows_setup.installer_title,
        installerDesc: t.download.windows_setup.installer_desc,
        portableTitle: t.download.windows_setup.portable_title,
        portableDesc: t.download.windows_setup.portable_desc,
        securityNote: t.download.windows_setup.security_note
      }}
      macosSetup={{
        title: t.download.macos_setup.title,
        availableVersions: t.download.macos_setup.available_versions,
        step1: t.download.macos_setup.step_1,
        step2: t.download.macos_setup.step_2,
        step3: t.download.macos_setup.step_3,
        step4: t.download.macos_setup.step_4,
        step5: t.download.macos_setup.step_5,
        securityTitle: t.download.macos_setup.security_title,
        securityDescription: t.download.macos_setup.security_description,
        standardMethod: t.download.macos_setup.standard_method,
        standardStep1: t.download.macos_setup.standard_step_1,
        standardStep2: t.download.macos_setup.standard_step_2,
        standardStep3: t.download.macos_setup.standard_step_3,
        advancedMethod: t.download.macos_setup.advanced_method,
        optionA: t.download.macos_setup.option_a,
        optionB: t.download.macos_setup.option_b,
        terminalCommandDesc: t.download.macos_setup.terminal_command_desc,
        firstTimeOnly: t.download.macos_setup.first_time_only
      }}
      linuxSetup={{
        title: t.download.linux_setup.title,
        step1: t.download.linux_setup.step_1,
        step2: t.download.linux_setup.step_2,
        step3: t.download.linux_setup.step_3,
        fuseNotePrefix: t.download.linux_setup.fuse_note_prefix,
        fuseNoteCommand: t.download.linux_setup.fuse_note_command,
        apparmorNotePrefix: t.download.linux_setup.apparmor_note_prefix,
        apparmorNoteCommand: t.download.linux_setup.apparmor_note_command
      }}
      otherVersions={{
        title: t.download.other_versions.title,
        description: t.download.other_versions.description,
        button: t.download.other_versions.button
      }}
      requirementsSection={{
        title: t.download.requirements_section.title,
        minimum: t.download.requirements_section.minimum,
        recommended: t.download.requirements_section.recommended,
        cpuMin: t.download.requirements_section.cpu_min,
        ramMin: t.download.requirements_section.ram_min,
        diskMin: t.download.requirements_section.disk_min,
        cpuRec: t.download.requirements_section.cpu_rec,
        ramRec: t.download.requirements_section.ram_rec,
        diskRec: t.download.requirements_section.disk_rec
      }}
      sourceCodeGithub={t.download.source_code_github}
    />
    
    <!-- Call to Action -->
    <section class="py-20 bg-gradient-to-b from-gray-800 to-gray-900">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">{t.footer.collaborate_title}</h2>
        <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
          {t.footer.collaborate_description}
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a 
            href="https://github.com/Pepelocotango/Gestor-Events_i_Personal" 
            target="_blank" 
            rel="noopener noreferrer"
            class="px-8 py-4 bg-gray-800 hover:bg-gray-700 text-white font-semibold rounded-lg transition-colors flex items-center justify-center"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.167 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.163 22 16.416 22 12c0-5.523-4.477-10-10-10z"/>
            </svg>
            {t.footer.view_github}
          </a>
          <a 
            href="#features" 
            class="px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors"
          >
            {t.footer.view_features}
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Smooth scrolling for anchor links */
  html {
    scroll-behavior: smooth;
  }
  
  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  
  ::-webkit-scrollbar-track {
    background: #1f2937;
  }
  
  ::-webkit-scrollbar-thumb {
    background: #4b5563;
    border-radius: 5px;
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: #6b7280;
  }
</style>
