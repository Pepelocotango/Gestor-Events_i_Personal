---
import '../styles/global.css';
import LanguageSelector from '../components/LanguageSelector.astro';

interface Props {
  title: string;
  description?: string;
  currentLocale: string;
  currentPath: string;
  translations: {
    navigation: {
      home: string;
      features: string;
      product_tour: string;
      gallery: string;
      download: string;
      contact: string;
      menu: string;
      logo_text: string;
      gep_mailer: string;
    };
    footer: {
      title: string;
      version: string;
      source_code: string;
      documentation: string;
      collaborate_title: string;
      collaborate_description: string;
      view_github: string;
      view_features: string;
      copyright: string;
    };
    site: {
      title: string;
      description: string;
    };
  };
}

const { title, description, currentLocale = 'ca', currentPath = '/', translations } = Astro.props;

// Detectar si estamos en página de gep-mailer
const isGepMailerPage = currentPath.includes('/gep-mailer');

const siteTitle = translations.site.title;
const siteDescription = description || translations.site.description;
const url = 'https://gestor-events.vercel.app';

// Preload fonts
const fontLink = {
  rel: 'preconnect',
  href: 'https://fonts.googleapis.com',
};
const fontLink2 = {
  rel: 'preconnect',
  href: 'https://fonts.gstatic.com',
  crossorigin: 'true',
};
const fontLink3 = {
  rel: 'stylesheet',
  href: 'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap',
};
---

<!DOCTYPE html>
<html lang={currentLocale} class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={siteDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Preload Fonts -->
    <link {...fontLink} />
    <link {...fontLink2} />
    <link {...fontLink3} />
    
    <!-- React i18n -->
    <script define:vars={{ translations }}>
      // Initialize i18n for client-side components
      window.siteTranslations = translations;
    </script>
    
    <title>{title} | {siteTitle}</title>
    
    <!-- Open Graph / Social Media -->
    <meta property="og:title" content={`${title} | ${siteTitle}`} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${url}/images/desktop-dashboard.png`} />
    <meta property="og:type" content="website" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${siteTitle}`} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={`${url}/images/desktop-dashboard.png`} />
    
    <!-- Theme Color for Mobile Browsers -->
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)">
    
    <style is:global>
      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      
      ::-webkit-scrollbar-track {
        background: #0f172a;
      }
      
      ::-webkit-scrollbar-thumb {
        background: #334155;
        border-radius: 4px;
      }
      
      ::-webkit-scrollbar-thumb:hover {
        background: #475569;
      }
      
      /* Smooth scroll behavior */
      html {
        scroll-behavior: smooth;
      }
      
      /* Custom selection color */
      ::selection {
        background: rgba(99, 102, 241, 0.2);
        color: #e0e7ff;
      }
    </style>
  </head>
  <body class="min-h-screen bg-dark-900 text-gray-100 font-sans antialiased leading-relaxed">
    <div class="relative overflow-hidden">
      {/* Gradient background elements */}
      <div class="absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-brand-500/5 via-transparent to-transparent"></div>
        <div class="absolute bottom-0 right-0 w-1/2 h-1/2 bg-[radial-gradient(ellipse_at_bottom_left,_var(--tw-gradient-stops))] from-brand-500/10 via-transparent to-transparent"></div>
        <div class="absolute inset-0 bg-[url('/images/grid.svg')] opacity-5"></div>
      </div>
      
      <header class="bg-gray-900/95 backdrop-blur-sm border-b border-gray-800 sticky top-0 z-50">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
          <a href={currentLocale === 'ca' ? '/' : `/${currentLocale}/`} class="flex items-center space-x-2">
            <img 
              src="/images/black_icon-64.png" 
              alt="Logo GEP" 
              class="h-10 w-auto"
              width="40"
              height="40"
              loading="eager"
            />
            <span class="text-xl font-bold bg-gradient-to-r from-brand-400 to-brand-600 bg-clip-text text-transparent">
              {translations.navigation.logo_text}
            </span>
          </a>
          <nav class="hidden lg:block">
            <ul class="flex space-x-8">
              <li><a href={isGepMailerPage ? (currentLocale === 'ca' ? '/' : `/${currentLocale}/`) : '#home'} class="text-gray-300 hover:text-white transition-colors font-medium">{translations.navigation.home}</a></li>
              {isGepMailerPage ? null : <li><a href="#features" class="text-gray-300 hover:text-white transition-colors font-medium">{translations.navigation.features}</a></li>}
              {isGepMailerPage ? null : <li><a href="#product-tour" class="text-gray-300 hover:text-white transition-colors font-medium">{translations.navigation.product_tour}</a></li>}
              {isGepMailerPage ? null : <li><a href="#gallery" class="text-gray-300 hover:text-white transition-colors font-medium">{translations.navigation.gallery}</a></li>}
              <li><a href="#download" class="text-gray-300 hover:text-white transition-colors font-medium">{translations.navigation.download}</a></li>
              <li><a href={currentLocale === 'ca' ? '/ca/gep-mailer' : `/${currentLocale}/gep-mailer`} class="text-gray-300 hover:text-white transition-colors font-medium">{translations.navigation.gep_mailer}</a></li>
            </ul>
          </nav>
          <LanguageSelector currentLocale={currentLocale} currentPath={currentPath} />
        </div>
      </header>

      <main class="flex-grow">
        <slot />
      </main>

      <footer class="bg-gray-900 border-t border-gray-800 py-12">
        <div class="container mx-auto px-4">
          <div class="flex flex-col md:flex-row justify-between items-center">
            <div class="mb-6 md:mb-0 text-center md:text-left">
              <h3 class="text-lg font-semibold mb-2 text-white">{siteTitle}</h3>
              <p class="text-gray-400">{translations.footer.version}</p>
            </div>
            <div class="flex space-x-6">
              {isGepMailerPage ? (
                <>
                  <a href="https://github.com/Pepelocotango/gep-mailer-proto" 
                     target="_blank" 
                     rel="noopener noreferrer" 
                     class="text-gray-400 hover:text-white transition-colors">
                    {translations.footer.source_code}
                  </a>
                  <a href="https://github.com/Pepelocotango/gep-mailer-proto/blob/main/README.md" 
                     target="_blank"
                     rel="noopener noreferrer"
                     class="text-gray-400 hover:text-white transition-colors">
                    {translations.footer.documentation}
                  </a>
                </>
              ) : (
                <>
                  <a href="https://github.com/Pepelocotango/Gestor-Events_i_Personal" 
                     target="_blank" 
                     rel="noopener noreferrer" 
                     class="text-gray-400 hover:text-white transition-colors">
                    {translations.footer.source_code}
                  </a>
                  <a href="https://github.com/Pepelocotango/Gestor-Events_i_Personal/blob/main/README.md" 
                     target="_blank"
                     rel="noopener noreferrer"
                     class="text-gray-400 hover:text-white transition-colors">
                    {translations.footer.documentation}
                  </a>
                </>
              )}
            </div>
          </div>
          <div class="border-t border-gray-800 mt-8 pt-8 text-center text-gray-500 text-sm">
            <p>{translations.footer.copyright}</p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  :root {
    --color-primary: #2563eb;
    --color-primary-light: #3b82f6;
    --color-primary-dark: #1d4ed8;
  }
  
  html {
    scroll-behavior: smooth;
  }
  
  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }
  
  ::-webkit-scrollbar-track {
    background: #111827;
  }
  
  ::-webkit-scrollbar-thumb {
    background: #4b5563;
    border-radius: 4px;
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: #6b7280;
  }
  
  /* Gradient text */
  .gradient-text {
    background: linear-gradient(90deg, #2563eb, #06b6d4);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  
  /* Animation for blobs */
  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }
  
  .animate-blob {
    animation: blob 7s infinite;
  }
  
  .animation-delay-2000 {
    animation-delay: 2s;
  }
</style>
