### INICI FITXER: .gitignore ###
#carpetes i fitxers personals
gestor-d'esdeveniments_react_vite_gemini BUILD.code-workspace
chekpoints/
releases/
00SCRIPTS_TEMP/
XTEMP/

# Dependències de Node.js
# Aquesta carpeta es regenera amb 'npm install'
node_modules/

# Sortida de la compilació (build)
# Aquesta carpeta es genera amb 'npm run build' o 'npm run build:electron'
dist/

# Fitxers de variables d'entorn locals
# ¡MOLT IMPORTANT! Contenen claus secretes i no han de ser a GitHub.
.env
.env.local
.env.*.local

# Fitxers de log
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Fitxers de l'editor de codi i IDE
.vscode/
*.code-workspace
.idea/

# Fitxers del sistema operatiu
.DS_Store
Thumbs.db

# Cache de Python (pels teus scripts auxiliars)
__pycache__/
*.pyc


# Credencials de Google
google-credentials.json
service-account.json

# Binaris i fitxers temporals per error
node
npm
vite
rm
concurrently
wait-on
gestor-esdeveniments-personal@*

# Configuració i context de Gemini 
.gemini/

# Fitxers generats per l'aplicació (a la carpeta userData del sistema, no del projecte)
# session.json, backups/, google-tokens.json, google-config.json
# Aquests fitxers es generen a app.getPath('userData') i no cal ignorar-los aquí

# Cache i build d'Astro (apps_web/landing)
apps_web/landing/.astro/
apps_web/landing/dist/

### FINAL FITXER: .gitignore ###
.aider*
